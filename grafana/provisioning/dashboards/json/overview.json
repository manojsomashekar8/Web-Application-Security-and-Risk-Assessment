{
  "title": "WASRA overview",
  "uid": "wasra-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scans by status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wasra_scans",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Findings by ZAP risk",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wasra_findings",
          "legendFormat": "{{zap_risk}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Average framework risk per target",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wasra_avg_risk",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Scans over time",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "uid": "wasra-db"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.id, t.url, s.status, s.started_at, s.finished_at, s.finished_at - s.started_at AS duration FROM scans s JOIN targets t ON t.id = s.target_id ORDER BY s.id DESC LIMIT 100"
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Unique findings by classification",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wasra_findings_by_class",
          "legendFormat": "{{classification}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "pieType": "donut"
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Raw alerts vs unique findings per target",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wasra_alerts",
          "legendFormat": "{{target}} {{kind}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Findings by framework band (latest scan per target)",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (band) (wasra_findings_by_band{target=~\"$target\"})",
          "legendFormat": "{{band}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Scan duration per stage (seconds)",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wasra_scan_stage_seconds{target=~\"$target\"}",
          "legendFormat": "{{stage}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Findings with n/a enrichment (no CVSS)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(wasra_enrichment_na{target=~\"$target\"})",
          "legendFormat": "n/a"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Top-10 overlap: framework vs CVSS-only",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(wasra_top10_overlap{target=~\"$target\"})",
          "legendFormat": "overlap"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scan CPU and memory during the latest scan (per target)",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wasra_scan_usage{target=~\"$target\", stat=~\"cpu_peak_pct|mem_peak_mib\"}",
          "legendFormat": "{{target}} {{container}} {{stat}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": {
          "query": "label_values(wasra_alerts, target)",
          "refId": "PrometheusVariableQueryEditor"
        },
        "definition": "label_values(wasra_alerts, target)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  }
}
